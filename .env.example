# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27018/afdb_beta

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=30d

# SSO-IDP Federation
SSO_SHARED_SECRET=shared-secret-with-idp
SSO_TOKEN_EXPIRY_MINUTES=5

# Google OAuth2 (register at https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/sso/callback/google

# Microsoft / Azure AD (register at https://portal.azure.com)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/v1/sso/callback/microsoft

# Core Backend
CORE_API_URL=http://localhost:4001/api/v1
CORE_API_KEY=internal-api-key

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend URL (for SSO callbacks)
FRONTEND_URL=http://localhost:3000
