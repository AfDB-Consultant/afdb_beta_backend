# ═══════════════════════════════════════════════════════════════
#  AfDB Platform — Production Environment
# ═══════════════════════════════════════════════════════════════
#  Copy this file to .env and replace ALL values before deploying
# ═══════════════════════════════════════════════════════════════

# ── Domain ────────────────────────────────────────────────────
DOMAIN=atradezone.ca

# ── Service URLs ─────────────────────────────────────────────
BETA_FRONTEND_URL=https://afdb-beta.atradezone.ca
CORE_FRONTEND_URL=https://afdb-core.atradezone.ca
BETA_API_URL=https://afdb-api.atradezone.ca
CORE_API_URL=https://afdb-core-api.atradezone.ca

# ── MongoDB ───────────────────────────────────────────────────
MONGO_ROOT_USER=afdb_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_strong_mongo_password

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ── Internal API Key (Beta ↔ Core communication) ─────────────
INTERNAL_API_KEY=generate_a_long_random_string_here

# ── JWT Secrets (Beta Backend) ────────────────────────────────
# IMPORTANT: Both backends MUST use the SAME access secret
JWT_ACCESS_SECRET=generate_a_long_random_jwt_secret_here
JWT_REFRESH_SECRET=generate_a_different_long_random_secret_here
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=30d

# ── SSO-IDP Federation (Beta Backend) ────────────────────────
SSO_SHARED_SECRET=generate_sso_shared_secret_here
SSO_TOKEN_EXPIRY_MINUTES=5

# ── Google OAuth2 (optional) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://afdb-api.atradezone.ca/api/v1/sso/callback/google

# ── Microsoft / Azure AD (optional) ──────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=https://afdb-api.atradezone.ca/api/v1/sso/callback/microsoft

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=https://afdb-beta.atradezone.ca,https://afdb-core.atradezone.ca
